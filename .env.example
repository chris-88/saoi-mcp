# No secrets: saoi-api's comparison routes are public.
PORT=3000
SAOI_API_URL=http://saoi-api:3000
# Optional
SAOI_TIMEOUT_MS=30000
ALLOWED_HOSTS=mcp.saoi.ie,mcp.chrisquinn.ie,localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=mcp.saoi.ie,mcp.chrisquinn.ie,claude.ai,claude.com,localhost,127.0.0.1,[::1]
KEEPALIVE_MS=25000
# The exact URL connectors are configured with: the cards' ui.domain is its hash; the icons are served from its origin.
PUBLIC_URL=https://mcp.saoi.ie/mcp
# OpenAI's domain verification token for the app directory; /.well-known/openai-apps-challenge is 404 when unset.
OPENAI_APPS_CHALLENGE=
