ALLOWED_HOSTS=mcp.chrisquinn.ie,localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=mcp.chrisquinn.ie,claude.ai,claude.com,localhost,127.0.0.1,[::1]
KEEPALIVE_MS=25000
